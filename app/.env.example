# Copie para app/.env. Todas as variáveis são opcionais: sem elas, valem os
# valores abaixo. Caminhos relativos são relativos à pasta app/.

# Modelo do BERT usado para gerar os embeddings (nome no Hugging Face ou pasta local).
MODEL_NAME=neuralmind/bert-base-portuguese-cased

# Classificador treinado (joblib), usando os 768 embeddings do BERT.
# Padrão: a Regressão Logística, modelo final da documentação (seção 7.5).
CLASSIFICATION_MODEL=model/logistic_regression_model.pkl

# Origens que podem chamar a API pelo navegador, separadas por vírgula.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Região da busca de conteúdos relacionados (sintaxe do ddgs).
SEARCH_REGION=br-pt

# Limite de consultas por IP (sintaxe do slowapi: "5/minute", "100/hour"...).
RATE_LIMIT=5/minute
