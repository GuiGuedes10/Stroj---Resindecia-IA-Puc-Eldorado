# Copie para app/.env. Todas as variáveis são opcionais: sem elas, valem os
# valores abaixo. Caminhos relativos são relativos à pasta app/.

# Modelo do BERT usado para gerar os embeddings (nome no Hugging Face ou pasta local).
MODEL_NAME=neuralmind/bert-base-portuguese-cased

# Classificador treinado (joblib). Aceita modelos com 768 features (só BERT)
# ou 772 (BERT + as 4 features de texto de utils/utils.py).
# Padrão: a Regressão Logística, modelo final da documentação (seção 7.5).
# O SVM, baseline do estudo, está em model/svm_(rbf)_model.pkl.
CLASSIFICATION_MODEL=../model/supervised/results/logistic_regression_model.pkl

# Scaler das 4 features de texto, que entram padronizadas por média e
# desvio-padrão (documentação, seção 5.4). Deixe vazio para um modelo
# treinado com as features cruas.
SCALER_MODEL=model/scaler.pkl

# Origens que podem chamar a API pelo navegador, separadas por vírgula.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Limite de consultas por IP (sintaxe do slowapi: "5/minute", "100/hour"...).
RATE_LIMIT=5/minute
